{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" }
  ],
  "crons": [
    {
      "path": "/api/morning-message",
      "schedule": "0 20 * * *"
    },
    {
      "path": "/api/post-x",
      "schedule": "50 14 * * *"
    }
  ]
}
